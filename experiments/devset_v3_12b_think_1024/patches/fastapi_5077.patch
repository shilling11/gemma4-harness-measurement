+++ b/reproduce_issue.py
@@ -0,0 +1,27 @@
+import functools
+import inspect
+from typing import ForwardRef, List, Optional
+from fastapi.dependencies.utils import get_typed_signature
+
+def original_func(a: List[int]) -> None:
+    pass
+
+@functools.wraps(original_func)
+def wrapped_func(a: List[int]) -> None:
+    pass
+
+# Let's try a forward reference
+def func_with_forward_ref(a: "List[int]") -> None:
+    pass
+
+@functools.wraps(func_with_forward_ref)
+def wrapped_func_with_forward_ref(a: "List[int]") -> None:
+    pass
+
+try:
+    signature = get_typed_signature(wrapped_func_with_forward_ref)
+    print(signature)
+except Exception as e:
+    print(f"Caught exception: {e}")
+    import traceback
+    traceback.print_exc()
