@@ -0,0 +1,16 @@
+import sys
+from rich.traceback import Traceback
+
+def reproduce():
+    e1 = Exception("e1")
+    e2 = Exception("e2")
+    e1.__cause__ = e2
+    e2.__cause__ = e1
+    
+    try:
+        raise e1
+    except Exception as e:
+        Traceback.from_exception(type(e), e, e.__traceback__)
+
+if __name__ == "__main__":
+    reproduce()
