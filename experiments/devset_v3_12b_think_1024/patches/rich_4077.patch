+import sys
+from rich.console import Console
+from rich.file_proxy import FileProxy
+
+# Test 1: Standard console
+console = Console()
+print(f"Standard console is_terminal: {console.is_terminal}")
+
+# Test 2: Console with FileProxy
+# We want to see if console.is_terminal is True when it's using a FileProxy
+# that wraps a terminal.
+proxy = FileProxy(console, sys.stdout)
+console_proxy = Console(file=proxy)
+print(f"Console with FileProxy is_terminal: {console_proxy.is_terminal}")
