@@ -0,0 +1,57 @@
+import inspect
+import functools
+import asyncio
+from typing import Callable, Any, Dict
+
+async def async_func(a: int, b: str) -> None:
+    pass
+
+def plain_func(a: int, b: str) -> None:
+    pass
+
+class CallableClass:
+    def __call__(self, a: int, b: str) -> None:
+        pass
+
+def get_typed_annotation(annotation: Any, globalns: Dict[str, Any]) -> Any:
+    if isinstance(annotation, str):
+        # This is a simplified version for the reproduction
+        # In reality, it would use ForwardRef and evaluate_forwardref
+        return annotation
+    return annotation
+
+def get_typed_signature(call: Callable[..., Any]) -> inspect.Signature:
+    signature = inspect.signature(call)
+    unwrapped = inspect.unwrap(call)
+    globalns = getattr(unwrapped, "__globals__", {})
+    typed_params = [
+        inspect.Parameter(
+            name=param.name,
+            kind=param.kind,
+            default=param.default,
+            annotation=get_typed_annotation(param.annotation, globalns),
+        )
+        for param in signature.parameters.values()
+    ]
+    typed_signature = inspect.Signature(typed_params)
+    return typed_signature
+
+test_cases = [
+    ("Plain function", plain_func),
+    ("Async function", async_func),
+    ("Callable class", CallableClass()),
+]
+
+for name, func in test_cases:
+    partial_func = functools.partial(func, a=1)
+    print(f"{name}:")
+    print(f"  Original: {inspect.signature(func)}")
+    print(f"  Partial: {inspect.signature(partial_func)}")
+    try:
+        print(f"  Typed: {get_typed_signature(partial_func)}")
+    except Exception as e:
+        print(f"  Typed: Error: {e}")
+    print("-" * 20)
+
+if __name__ == "__main__":
+    pass
