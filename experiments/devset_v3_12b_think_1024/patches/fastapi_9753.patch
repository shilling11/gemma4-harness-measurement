@@ -0,0 +1,31 @@
+import inspect
+import functools
+import asyncio
+from typing import Callable, Any
+
+async def async_func(a: int, b: str) -> None:
+    pass
+
+def plain_func(a: int, b: str) -> None:
+    pass
+
+class CallableClass:
+    def __call__(self, a: int, b: str) -> None:
+        pass
+
+def test_signatures():
+    # Plain function
+    p_func = functools.partial(plain_func, a=1)
+    print(f"Plain func partial: {inspect.signature(p_func)}")
+
+    # Async function
+    a_func = functools.partial(async_func, a=1)
+    print(f"Async func partial: {inspect.signature(a_func)}")
+
+    # Callable class instance
+    c_obj = CallableClass()
+    c_partial = functools.partial(c_obj, a=1)
+    print(f"Callable class partial: {inspect.signature(c_partial)}")
+
+if __name__ == "__main__":
+    test_signatures()
