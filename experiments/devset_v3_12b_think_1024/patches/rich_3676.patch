index 00000000..f3448388
--- /dev/null
+++ b/reproduce_notes.py
@@ -0,0 +1,17 @@
+import sys
+from rich.traceback import install
+
+class MyError(Exception):
+    def __init__(self, message, notes='default'):
+        super().__init__(message)
+        self.__notes__ = notes
+
+def fail():
+    raise MyError("test", notes="extra notes")
+
+if __name__ == "__main__":
+    install()
+    try:
+        fail()
+    except Exception:
+        pass
