+from rich.cells import chop_cells
+from rich._wrap import divide_line
+
+# Case: line_position is 1, width is 2, word is "你好" (4 cells)
+text = " 你好"
+width = 2
+divides = divide_line(text, width, fold=True)
+print(f"Text: {text!r}, Width: {width}, Divides: {divides}")
+
+def wrap_text(text, width):
+    divides = divide_line(text, width, fold=True)
+    lines = []
+    start = 0
+    for d in divides:
+        lines.append(text[start:d])
+        start = d
+    lines.append(text[start:])
+    return lines
+
+print(f"Wrapped lines: {wrap_text(text, width)}")
