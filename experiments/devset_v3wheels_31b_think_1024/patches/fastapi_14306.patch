+def get_endpoint_context(
+    dependant: Dependant,
+    path: str,
+    methods: Optional[Union[Set[str], List[str]]] = None,
+) -> Optional[str]:
+    if dependant.call is None:
+        return None
+
+    call = _unwrapped_call(dependant.call)
+    try:
+        file = inspect.getfile(call)
+        _, start_line = inspect.getsourcelines(call)
+    except (TypeError, OSError):
+        return None
+
+    function_name = call.__name__
+    if methods:
+        method_str = ", ".join(sorted(methods)) if methods else "UNKNOWN"
+    else:
+        method_str = "WS"
+
+    return f'File "{file}", line {start_line}, in {function_name}\n    {method_str} {path}'
