+def split_graphemes(text: str) -> list[str]:
+    """Split text into graphemes."""
+    if not text:
+        return []
+    graphemes = []
+    current_grapheme = text[0]
+    for char in text[1:]:
+        if unicodedata.combining(char) or char == "\u200d":
+            current_grapheme += char
+        elif current_grapheme[-1] == "\u200d":
+            current_grapheme += char
+        else:
+            graphemes.append(current_grapheme)
+            current_grapheme = char
+    graphemes.append(current_grapheme)
+    return graphemes
+
