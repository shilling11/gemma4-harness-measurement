diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..efe92b39
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,25 @@
+import pickle
+import requests
+import json
+
+try:
+    # Create a JSONDecodeError
+    # json.JSONDecodeError(msg, doc, pos)
+    exc = requests.exceptions.JSONDecodeError("Expecting value", "invalid json", 0)
+    
+    # Pickle and unpickle
+    pickled = pickle.dumps(exc)
+    unpickled = pickle.loads(pickled)
+    
+    print(f"Original: msg={exc.msg}, doc={exc.doc}, pos={exc.pos}")
+    print(f"Unpickled: msg={getattr(unpickled, 'msg', 'N/A')}, doc={getattr(unpickled, 'doc', 'N/A')}, pos={getattr(unpickled, 'pos', 'N/A')}")
+    
+    assert exc.msg == unpickled.msg
+    assert exc.doc == unpickled.doc
+    assert exc.pos == unpickled.pos
+    print("Successfully pickled and unpickled!")
+except Exception as e:
+    print(f"Failed: {e}")
+    import traceback
+    traceback.print_exc()
+    exit(1)
