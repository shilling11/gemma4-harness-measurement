+def get_endpoint_context(endpoint: Callable, method: str, path: str) -> Dict[str, Any]:
+    try:
+        frame = inspect.getframeinfo(endpoint)
+        filepath = frame.filename
+        line_number = frame.lineno
+        function_name = endpoint.__name__
+    except Exception:
+        filepath = "unknown"
+        line_number = 0
+        function_name = "unknown"
+
+    return {
+        "filepath": filepath,
+        "line_number": line_number,
+        "function_name": function_name,
+        "method": method,
+        "path": path,
+    }
+
