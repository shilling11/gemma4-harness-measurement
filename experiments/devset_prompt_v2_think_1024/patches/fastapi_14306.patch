diff --git a/fastapi/routing.py b/fastapi/routing.py
index c10175b1..5364f1df 100644
--- a/fastapi/routing.py
+++ b/fastapi/routing.py
@@ -79,6 +79,38 @@ from starlette.websockets import WebSocket
 from typing_extensions import Annotated, deprecated
 
 
+def get_endpoint_context(dependant: Dependant, route: Any = None) -> Optional[str]:
+    if hasattr(dependant, "endpoint_context"):
+        return dependant.endpoint_context
+
+    func = dependant.call
+    if func is None:
+        dependant.endpoint_context = None
+        return None
+
+    try:
+        import inspect
+        import os
+        file = os.path.abspath(inspect.getfile(func))
+        lines, start_line = inspect.getsourcelines(func)
+        func_name = func.__name__
+    except Exception:
+        dependant.endpoint_context = None
+        return None
+
+    context = f"File \"{file}\", line {start_line}, in {func_name}"
+
+    if route:
+        if hasattr(route, "methods"):
+            methods = " ".join(sorted(route.methods)) if isinstance(route.methods, set) else " ".join(route.methods)
+            context += f"\n    {methods} {route.path}"
+        else:
+            context += f"\n    WS {route.path}"
+
+    dependant.endpoint_context = context
+    return context
+
+
