@@ -0,0 +1,20 @@
+
+from rich.traceback import install
+import sys
+
+def fail():
+    raise RuntimeError("First error")
+
+def fail_recursive():
+    try:
+        fail()
+    except Exception:
+        # This should trigger the rich traceback handler
+        # If the handler itself raises an exception, it might cause recursion
+        raise RuntimeError("Second error") from None
+
+install()
+try:
+    fail_recursive()
+except Exception:
+    pass
