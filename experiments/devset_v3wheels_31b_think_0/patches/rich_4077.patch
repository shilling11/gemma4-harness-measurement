+from rich.console import Console
+from rich.file_proxy import FileProxy
+import sys
+import io
+
+def test_file_proxy_isatty():
+    # Create a dummy file that has an isatty method
+    class MockFile(io.TextIOBase):
+        def isatty(self):
+            return True
+        def fileno(self):
+            return 1
+        def write(self, s):
+            return len(s)
+        def flush(self):
+            pass
+
+    mock_file = MockFile()
+    console = Console(file=mock_file, force_terminal=False)
+    proxy = FileProxy(console, mock_file)
+    
+    print(f"MockFile isatty: {mock_file.isatty()}")
+    try:
+        print(f"FileProxy isatty: {proxy.isatty()}")
+    except AttributeError as e:
+        print(f"AttributeError: {e}")
+        raise e
+    
+    assert proxy.isatty() == True
+
+if __name__ == "__main__":
+    try:
+        test_file_proxy_isatty()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        sys.exit(1)
