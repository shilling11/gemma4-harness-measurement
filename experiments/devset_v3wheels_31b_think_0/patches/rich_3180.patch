+from rich.console import Console
+import io
+from contextlib import redirect_stdout
+
+def test_double_width_wrap():
+    # Width 1.
+    # 'こんにちは' (10 cells)
+    # Each char is 2 cells.
+    # If width is 1, and we have a 2-cell char, it should still be printed, 
+    # but it should probably be on its own line.
+    console = Console(width=1, force_terminal=True)
+    text = "こんにちは"
+    
+    f = io.StringIO()
+    with redirect_stdout(f):
+        console.print(text)
+    
+    output = f.getvalue()
+    print(f"Output:\n{output}")
+
+if __name__ == "__main__":
+    test_double_width_wrap()
