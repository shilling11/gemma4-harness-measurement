@@ -50,6 +50,19 @@ class Dependant:
     path: Optional[str] = None
     scope: Union[Literal["function", "request"], None] = None
 
+    @cached_property
+    def endpoint_context(self) -> str:
+        if self.call is None:
+            return ""
+        try:
+            unwrapped = _unwrapped_call(self.call)
+            file = inspect.getfile(unwrapped)
+            line = inspect.getlineno(unwrapped)
+            name = unwrapped.__name__
+            return f"File \"{file}\", line {line}, in {name}"
+        except Exception:
+            return ""
+
     @cached_property
     def oauth_scopes(self) -> List[str]:
         scopes = self.parent_oauth_scopes.copy() if self.parent_oauth_scopes else []
