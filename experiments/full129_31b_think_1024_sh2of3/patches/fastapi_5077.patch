@@ -0,0 +1,29 @@
+import functools
+from typing import ForwardRef
+from fastapi.dependencies.utils import get_typed_signature
+import inspect
+
+class MyModel:
+    pass
+
+def original_func(x: "MyModel"):
+    return x
+
+@functools.wraps(original_func)
+def wrapper(x):
+    return original_func(x)
+
+print(f"Wrapper annotations: {wrapper.__annotations__}")
+print(f"Wrapper globals: {wrapper.__globals__.get('MyModel')}")
+
+sig = inspect.signature(wrapper)
+print(f"Param annotation: {sig.parameters['x'].annotation}")
+
+try:
+    typed_sig = get_typed_signature(wrapper)
+    print("Success!")
+except NameError as e:
+    print(f"Caught NameError: {e}")
+except Exception as e:
+    import traceback
+    traceback.print_exc()
