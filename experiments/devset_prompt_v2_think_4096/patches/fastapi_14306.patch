+def get_endpoint_metadata(dependant: "Dependant", route: "APIRoute") -> Optional[Dict[str, Any]]:
+    if dependant.call is None:
+        return None
+    try:
+        unwrapped = inspect.unwrap(dependant.call)
+        file = inspect.getfile(unwrapped)
+        _, start_line = inspect.getsourcelines(unwrapped)
+        name = unwrapped.__name__
+        methods = route.methods
+        method_str = ", ".join(sorted(methods)) if methods else ""
+        return {
+            "file": file,
+            "line": start_line,
+            "name": name,
+            "method": method_str,
+            "path": route.path,
+        }
+    except Exception:
+        return None
